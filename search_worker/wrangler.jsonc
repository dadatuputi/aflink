  // Deployed by Cloudflare Workers Builds on pushes to master
  // (`cd search_worker && npx wrangler deploy`). The build command below runs
  // first and bundles the site's links into the worker, so the build's watch
  // paths have to include everything the links come from: see
  // search_worker/README.md. Local development: `npm run dev` serves the worker
  // on :8787, the suggestion URL a development build of the site points at.
  {
    "name": "aflink-autocomplete",
    "compatibility_date": "2025-07-03",
    "main": "src/index.js",
    "build": {
      "command": "node build-links.js"
    },
    // api.aflink.us serves everything this worker does: suggestions
    // (/search/), portal submissions (/submit) and MCP (/mcp). Attached once in
    // the dashboard (adding a custom domain needs zone permission the Workers
    // Builds token does not have); listed here so deploys keep it. workers.dev
    // stays on only while traffic moves over; turn it off (false) after
    // 2026-12-07.
    "workers_dev": true,
    "routes": [
      { "pattern": "api.aflink.us", "custom_domain": true }
    ],
    "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "32636ebd2ef14adc9d6e034e918600ec"
    }
  ]
  }
