  // Local development: `npm run dev` serves the worker on :8787, which is the
  // suggestion URL a development build of the site points at (see updater.js).
  // It reads the live https://aflink.us/links.json unless LINKS_URL is set —
  // put `LINKS_URL = "http://localhost:4000/links.json"` in .dev.vars to test
  // against a local build of the site instead.
  {
    "name": "aflink-autocomplete",
    "compatibility_date": "2025-07-03",
    "main": "src/index.js",
    // api.aflink.us serves everything this worker does: suggestions
    // (/search/), portal submissions (/submit) and MCP (/mcp). Attached once in
    // the dashboard (adding a custom domain needs zone permission the Workers
    // Builds token does not have); listed here so deploys keep it. workers.dev
    // stays on only while traffic moves over; turn it off (false) after
    // 2026-12-07.
    "workers_dev": true,
    "routes": [
      { "pattern": "api.aflink.us", "custom_domain": true }
    ],
    "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "32636ebd2ef14adc9d6e034e918600ec"
    }
  ]
  }