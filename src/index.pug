doctype html

//- (i) after a title the portal has stopped listing; the note is its tooltip
mixin unlisted(note)
  span.unlisted(title=note role="img" aria-label=note)
    svg(viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true")
      circle(cx="12" cy="12" r="10")
      path(d="M12 16v-5")
      path(d="M12 8h.01")

html.bg-spice-brown(lang='en')

  include includes/head.pug

  //- Navigation
  +navigation
    a.nav-link(href='#list') Official
    a.nav-link(href='#unofficial') Unofficial
    span.nav-separator.d-none.d-lg-inline= '|'
    a.nav-link(href='#about') About
    span.nav-separator.d-none.d-lg-inline= '|'
    a.nav-link(href='#update') Update Links
    if hasAnalytics
      span.nav-separator.d-none.d-lg-inline= '|'
      a.nav-link(href='/analytics') Usage
    span.nav-separator.d-none.d-lg-inline= '|'
    a.nav-link(href='/tutorial') Tutorial


  //- Page Content
  //- Announcements: data-driven from src/announcements.json, filtered to the
  //- build-time active window in updater.js
  if announcements.length
    section#alert.bg-sage.text-center
      each item in announcements
        if item.link
          a.no-dec(href=item.link)
            .container.alert.alert-primary.bg-cannes-blue.no-border.mb-2(role='alert')
              strong #{item.title}
              |
              | #{item.body}
        else
          .container.alert.alert-primary.bg-cannes-blue.no-border.mb-2(role='alert')
            strong #{item.title}
            |
            | #{item.body}
  section#search.bg-sage.text-center
    .container
      .form-outline
        input#search-form.form-control(type='search' placeholder='Start typing' aria-label='Search' autofocus='')
  section#list.bg-sage.text-center
    .container
      .offcenter
        h2 Official Links
        em.d-none.d-md-block(title=sync_tooltip) Synced #{sync_display}
      div#link-list.list-group
        //- Links json is expanded here
        each category in links
          - var links_not_deleted = category.links.filter(link => !link.isDeleted)
          if links_not_deleted.length > 0
            div.list-group
              //- Put a category here
              div.list-group-item.list-group-item-action.border-top.disabled.category #{category.category}
              //- Put each link in the category here
              each link in links_not_deleted
                .list-group-item.list-group-item-action.border-top.link-container
                  .link-main
                    .link-title
                      a.main-link(href=link.link class={'overridden': link.isOverridden, 'dead': link.isDead} data-content-id=(link.contentId) title=(link.isDead ? link.statusNote : link.isOverridden ? 'Overridden ' + link.overriddenTimestamp + '; Original: ' + link.overridden : link.title)) #{link.title}
                      //- The portal no longer lists this link; it stays until it dies or is reported.
                      //- A sibling of the anchor, not a child: search rewrites the anchor's text.
                      if link.isUnlisted && !link.isDead
                        +unlisted(link.statusNote)
                    //- One-line summary; the "…" opens the full description (search.js)
                    if link.summary
                      .link-summary
                        span.summary-text= link.summary
                        button.summary-more(type="button" aria-label=("Full description of " + link.title) data-description=(link.description || '') data-meta=link.detailMeta) …
                  a.override-link(target="_blank" title=("Correct link ID " + link.contentId) href=link.correction) 📝
                  a.override-link(target="_blank" title=("Delete link ID " + link.contentId) href=link.deletion) 🗑️
      p.alert-dark(hidden) No results for
        em
  if unofficial && unofficial.length > 0
    section#unofficial.bg-slate-blue.text-center
      .container
        .offcenter
          h2 Unofficial Links
        p.small.fst-italic.mb-2 Community-curated third-party tools. Not official DoD/USAF sites — not endorsed; use your own judgment.
        div#unofficial-list.list-group
          each link in unofficial
            .list-group-item.list-group-item-action.border-top.link-container
              .link-main
                .link-title
                  a.main-link(href=link.link class={'dead': link.isDead} data-content-id=(link.contentId) title=(link.isDead ? link.statusNote : link.title)) #{link.title}
                if link.summary
                  .link-summary
                    span.summary-text= link.summary
                    button.summary-more(type="button" aria-label=("Full description of " + link.title) data-description=(link.description || '') data-meta=link.detailMeta) …
              a.override-link(target="_blank" title=("Correct link ID " + link.contentId) href=link.correction) 📝
              a.override-link(target="_blank" title=("Delete link ID " + link.contentId) href=link.deletion) 🗑️
  section#about.bg-olive-drab.text-center
    .container
      h2 About
      p.lead
        | These links are mirrored from the AF Portal's Applications A-Z and quick link pages to be
        | quickly and easily accessible from anywhere

  include includes/update.pug

  section#footer.bg-spice-brown.py-1
    .row
      .col
        .text-start.d-flex.gap-3
          a.nav-link(href='/overrides') Overrides
          if hasAnalytics
            a.nav-link(href='/analytics') Usage

  include includes/foot.pug

//- Transition Modal
div#exit-modal.modal(tabindex=-1 style="display: none")
  .modal-dialog 
    .modal-content
      .modal-header.vstack.gap-1
        .text-center.mx-auto
          span Going to #[strong.title]...
        //- The destination URL is a real link, not inert text: a slow site
        //- (many .mil hosts take a long time to answer) leaves this modal up
        //- with no way forward, so the URL has to be clickable. Same window
        //- deliberately — no target — so it behaves like the row that was
        //- clicked. Styling is inherited (see .modal-header .link a).
        .link.text-center
          a(href='')
      .modal-body
        .progress
          .progress-bar.progress-bar-striped.progress-bar-animated(role=progressbar aria-label="Animated striped example" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="width: 100%")

//- Link details: the "…" after a summary opens this with the link's full
//- description (search.js fills it from the row)
div#detail-modal.modal(tabindex=-1 style="display: none")
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header.vstack.gap-1.align-items-start
        h5.modal-title.mb-0
        .meta
      .modal-body
        p.description.mb-0
      .modal-footer
        button.btn.btn-outline-secondary(type="button" data-bs-dismiss="modal") Close
        a.btn.btn-request.open-link(href="") Open
